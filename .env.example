PORT=3000

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://your-evolution-host
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=your-instance-name

# Groq
GROQ_API_KEY=your-groq-api-key

# Telegram MTProto (phone login, NOT a bot token)
# Get API_ID / API_HASH from https://my.telegram.org
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_PHONE=+2348012345678
# Filled in after the first /auth/telegram/verify-code login
TELEGRAM_SESSION=
