PORT=3000

# Evolution API (WhatsApp) - no instance name here, instances are per request
EVOLUTION_API_URL=https://your-evolution-host
EVOLUTION_API_KEY=your-evolution-api-key

# Groq (text + whisper-large-v3 voice notes)
GROQ_API_KEY=your-groq-api-key

# Telegram MTProto - one API_ID / API_HASH for the whole app.
# Every user logs in with their own phone + code; sessions are created automatically
# and stored in telegram_sessions.json. Get these from https://my.telegram.org
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
