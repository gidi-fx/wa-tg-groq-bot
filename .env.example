# ---------------------------------------------------------------------------
# WhatsApp Groq Router v2
# Copy to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------------------

PORT=3000

# ---------------------------------------------------------------------------
# Evolution API v2 (WhatsApp)
# ---------------------------------------------------------------------------
EVOLUTION_API_URL=https://your-evolution-host
EVOLUTION_API_KEY=your-evolution-api-key

# Optional - used when you press "Create instance" so Evolution calls this app.
# Defaults to the request host (or RENDER_EXTERNAL_URL on Render).
# PUBLIC_URL=https://your-app.example.com

# ---------------------------------------------------------------------------
# Supabase - OPTIONAL. Leave both blank to run from a temporary in-memory store
# (agents, inbox, groups and media reset on restart; a yellow banner is shown).
# To persist: create a free project at supabase.com, run supabase/schema.sql,
# then use the service_role key (Settings -> API -> service_role) below.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# Optional - only needed for browser Supabase Realtime in the inbox.
# The app falls back to polling when this is empty.
# SUPABASE_ANON_KEY=your-supabase-anon-key

# Storage bucket for agent media (created by schema.sql)
SUPABASE_MEDIA_BUCKET=agent-media

# ---------------------------------------------------------------------------
# AI providers (BYOK). Users can also add their own keys in /settings or per agent.
# ---------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=

# Optional Groq overrides
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3
# GROQ_TTS_MODEL=playai-tts
# GROQ_TTS_VOICE=Fritz-PlayAI

# Optional ElevenLabs voice replies. When set, it is tried before Groq TTS.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
