PORT=10000

# Evolution API (WhatsApp) - instances are discovered from the API.
EVOLUTION_API_URL=https://your-evolution-host
EVOLUTION_API_KEY=your-evolution-api-key

# OPTIONAL - pin one WhatsApp instance (otherwise every instance is used).
# EVOLUTION_INSTANCE=my-instance

# OPTIONAL - public URL Evolution should call for incoming messages.
# Defaults to https://wa-tg-groq-bot.onrender.com/webhook/evolution
# WEBHOOK_URL=https://wa-tg-groq-bot.onrender.com/webhook/evolution

# OPTIONAL - how long the WhatsApp typing indicator stays visible (ms, default 2500).
# WHATSAPP_TYPING_MS=2500

# Groq (text + whisper-large-v3 voice notes)
GROQ_API_KEY=your-groq-api-key

# Free Groq chat model. Falls back to openai/gpt-oss-20b, then llama-3.3-70b-versatile.
GROQ_MODEL=openai/gpt-oss-120b
# OPTIONAL - override the Groq API base URL (only useful for a self-hosted mock).
# GROQ_BASE_URL=

# Telegram MTProto - one API_ID / API_HASH for the whole app.
# Every user logs in with their own phone + code; sessions are created automatically
# and stored in telegram_sessions.json. Get these from https://my.telegram.org
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# OPTIONAL - only for hosts with an ephemeral disk (Render free tier).
# Leave empty locally. After the first /telegram/verify-code, copy the logged
# TELEGRAM_SESSIONS_JSON base64 value here (or into Render Environment) so
# sessions are restored after a redeploy. Never commit a real value.
# TELEGRAM_SESSIONS_JSON=
